# from tvm.script import tirx as T

@T.prim_func
def main(A_handle: T.handle, B_handle: T.handle, C_handle: T.handle):
    A = T.match_buffer(A_handle, (1, 5), "float16", strides=(5, 1))
    B = T.match_buffer(B_handle, (16, 3), "uint8", strides=(3, 1))
    C = T.match_buffer(C_handle, (1, 16), "float16", strides=(16, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        for by in T.thread_binding(1, thread="blockIdx.y"):
            tx: T.int32 = T.launch_thread_idx(0)
            ty: T.int32 = T.launch_thread_idx(1)
            tz: T.int32 = T.launch_thread_idx(2)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                T.sblock_attr({"tl.launch_threads": [128, 1, 1]})
                A_shared = T.sblock_alloc_buffer((16, 16), "float16", scope="shared.dyn")
                B_packed_shared = T.sblock_alloc_buffer((64, 8), "uint8", scope="shared.dyn")
                B_packed_fragment = T.sblock_alloc_buffer((64, 8), "uint8", scope="local.fragment")
                B_fp16_fragment = T.sblock_alloc_buffer((64, 16), "float16", scope="local.fragment")
                C_fragment = T.sblock_alloc_buffer((16, 64), scope="local.fragment")
                T.fill(T.region(C_fragment[0, 0], 2, 16, 64), 0)
                for ko in T.serial(1, annotations={"num_stages": 2}):
                    for i in T.parallel(16):
                        for j in T.parallel(16):
                            row: T.int32 = by * 16 + i
                            col: T.int32 = ko * 16 + j
                            A_shared[i, j] = T.if_then_else(T.bitwise_and(row < 1, col < 5), A[row, col], T.float16(0.0))
                    for i in T.parallel(64):
                        for j in T.parallel(8):
                            row: T.int32 = bx * 64 + i
                            col: T.int32 = ko * 8 + j
                            B_packed_shared[i, j] = T.if_then_else(T.bitwise_and(row < 16, col < 3), B[row, col], T.uint8(0))
                    T.copy(T.region(B_packed_shared[0, 0], 1, 64, 8), T.region(B_packed_fragment[0, 0], 2, 64, 8))
                    for i in T.parallel(64):
                        for j in T.parallel(16):
                            packed: T.int32 = T.Cast("int32", B_packed_fragment[i, j // 2])
                            nibble: T.int32 = T.bitwise_and(T.shift_right(packed, j % 2 * 4), 15)
                            signed: T.int32 = T.if_then_else(nibble >= 8, nibble - 16, nibble)
                            value: T.float16 = T.if_then_else(ko * 16 + j < 5, T.Cast("float16", signed), T.float16(0.0))
                            B_fp16_fragment[i, j] = value
                    T.gemm(T.region(A_shared[0, 0], 1, 16, 16), T.region(B_fp16_fragment[0, 0], 1, 64, 16), T.region(C_fragment[0, 0], 3, 16, 64), T.bool(False), T.bool(True), 16, 64, 16, 0, T.bool(False), 0, 0, 0)
                for i in T.parallel(16):
                    for j in T.parallel(64):
                        row: T.int32 = by * 16 + i
                        col: T.int32 = bx * 64 + j
                        if T.bitwise_and(row < 1, col < 16):
                            C[row, col] = T.Cast("float16", C_fragment[i, j])